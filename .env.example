# Скопируйте этот файл в .env.local и заполните значения при необходимости.
# Все переменные опциональны — без них сервис полностью работоспособен
# (используются демонстрационные данные и шаблонное AI-заключение).

# Ключ Google Gemini API (https://aistudio.google.com/app/apikey).
# Если не задан — сервис автоматически использует шаблонное AI-резюме
# без обращения к внешнему ИИ.
GEMINI_API_KEY=

# Название модели Gemini. Рекомендуется экономичная Flash/Flash-Lite модель.
GEMINI_MODEL=gemini-3.5-flash-lite

# Ключ DaData (https://dadata.ru/api/find-party/) — бесплатный тариф, до 10 000
# запросов/день. Даёт РЕАЛЬНЫЕ данные ЕГРЮЛ (название, статус, адрес,
# руководитель, ОКВЭД, дата регистрации, признак недостоверности сведений)
# для установочных данных компании (вкладка «Обзор» / шапка страницы).
# Если не задан — используются демонстрационные установочные данные, как и
# для остальных разделов досье (финансы, суды, ФССП и т.д. — они пока всегда
# демонстрационные, см. README).
DADATA_API_KEY=
